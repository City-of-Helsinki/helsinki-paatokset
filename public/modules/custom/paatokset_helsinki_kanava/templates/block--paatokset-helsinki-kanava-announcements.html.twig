{% set announcement_content %}
  <p>{{ content.announcement.text }}</p>
  <p>{{ content.announcement.link }}</p>
{% endset %}

<div class="block--announcements">
  <div class="container">
    {% include "@hdbt/misc/status-message.twig" with
      {
        type: 'info',
        size: 'large',
        title: 'Upcoming council meeting'|t,
        messages: [
          announcement_content,
        ]
      }
    %}
  </div>
</div>
