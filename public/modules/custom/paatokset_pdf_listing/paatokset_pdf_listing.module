<?php

/**
 * @file
 * Primary module hooks for PDF listing module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\views\Views;

/**
 * Implements hook_theme().
 */
function paatokset_pdf_listing_theme($existing, $type, $theme, $path) {
  return [
    'paragraph__pdf_listing' => [
      'render element' => 'elements',
      'template' => 'paragraph--pdf-listing',
      'path' => $path . '/templates/paragraph',
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function paatokset_pdf_listing_preprocess_paragraph__pdf_listing(&$variables) {
  if (empty($variables['paragraph']) || !$variables['paragraph'] instanceof Paragraph) {
    return;
  }
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_pdf_category')) {
    return;
  }

  $tids = array_column($paragraph->get('field_pdf_category')->getValue(), 'target_id');

  $view = Views::getView('pdf_listing');
  if (!$view) {
    return;
  }

  $view->setDisplay('default');

  // Multiple listings on the same page must not share query parameters,
  // otherwise selecting a year or a page would affect all of them.
  $index = _paatokset_pdf_listing_get_index($paragraph);
  if ($index > 0) {
    $display = $view->getDisplay();

    $filters = $display->getOption('filters');
    $filters['field_pdf_date_year']['expose']['identifier'] = 'year_' . ($index + 1);
    $display->overrideOption('filters', $filters);

    $pager = $display->getOption('pager');
    $pager['options']['id'] = $index;
    $display->overrideOption('pager', $pager);
  }

  // Empty argument lists all categories.
  $arguments = $tids ? [implode('+', $tids)] : [];
  $build = $view->buildRenderable('default', $arguments);
  $build['#cache']['keys'][] = 'pdf_listing_index:' . $index;
  $variables['view'] = $build;
}

/**
 * Gets the position of the paragraph among PDF listings in its parent field.
 */
function _paatokset_pdf_listing_get_index(Paragraph $paragraph): int {
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;

  if (!$parent instanceof FieldableEntityInterface || !$field_name || !$parent->hasField($field_name)) {
    return 0;
  }

  $index = 0;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ($sibling->id() === $paragraph->id()) {
      return $index;
    }
    if ($sibling->bundle() === 'pdf_listing') {
      $index++;
    }
  }

  return 0;
}
