{#
/**
 * @file
 * Single meeting in the frontpage calendar.
 *
 * Available variables:
 * - meeting: \Drupal\paatokset_ahjo_api\Entity\Meeting.
 * - policymaker: \Drupal\paatokset_ahjo_api\Entity\Policymaker, if found.
 */
#}
{% set link = null %}
{% set label = null %}
{% set phase = meeting.getMeetingPhase().value ?? null %}

{% if policymaker and phase == 'decision' %}
  {% set link = meeting.getDecisionAnnouncementUrl(null, policymaker) %}
  {% set label = 'Open decision announcement'|t %}
{% elseif policymaker and phase == 'agenda' %}
  {% set link = meeting.getMinutesUrl(null, policymaker) %}
  {% set label = 'Open agenda'|t %}
{% elseif policymaker and phase == 'minutes' %}
  {% set link = meeting.getMinutesUrl(null, policymaker) %}
  {% set label = 'Open minutes'|t %}
{% endif %}

{% set policymaker_name = policymaker ? policymaker.getPolicymakerName() : null %}

<div class="frontpage-calendar__item">
  <div class="frontpage-calendar__item-inner">
    <div class="color-line bg--{{ (policymaker ? policymaker.getPolicymakerClass() : 'color-board')|clean_class }}"></div>
    <div class="content-container">
      <span class="meeting-date">{{ meeting.getMeetingTimestamp()|date("d.m.Y — H:i") }}</span>
      <h3>{{ policymaker_name }}</h3>
      {% if link %}
        <a class="motions-link" href="{{ link.toString() }}">
          <span>{{ label }}</span>
          <span class="visually-hidden">: {{ policymaker_name }}</span>
          <i class="hel-icon hel-icon--angle-right"></i>
        </a>
      {% endif %}
    </div>
  </div>
</div>
