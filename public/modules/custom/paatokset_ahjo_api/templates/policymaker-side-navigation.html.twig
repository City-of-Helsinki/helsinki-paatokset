{#
/**
 * @file
 * Policymaker section navigation.
 *
 * Uses the hdbt section navigation markup: a sidebar navigation on desktop
 * and a collapsible navigation on mobile.
 *
 * Available variables:
 * - items: Navigation items, see menu.html.twig.
 * - menu_attributes: HTML attributes for the menu element.
 * - menu_link_parent: The navigation heading link.
 *   - title: Link title.
 *   - url: Link URL.
 */
#}
{% set id = 'policymaker-side-navigation' %}
{% set section_menu_title_link = id ~ '-menu-link' %}
{% set section_menu_aria_controls = id ~ '-menu-wrapper' %}
{% set heading_id = id ~ '-menu' %}

<nav aria-labelledby="{{ heading_id }}" class="sidebar-navigation sidebar-navigation--section-navigation">
  <div class="section-navigation__header">
    <div id="{{ heading_id }}" class="sidebar-navigation__title section-navigation__title">
      {{ link(menu_link_parent.title, menu_link_parent.url, {
        'id': section_menu_title_link,
        'class': ['sidebar-navigation__title-link'],
      }) }}
    </div>
    <span class="section-navigation__toggle-wrapper">
      <button
        type="button"
        aria-expanded="false"
        aria-controls="{{ section_menu_aria_controls }}"
        aria-labelledby="{{ section_menu_title_link }}"
        aria-haspopup="true"
        class="menu__toggle-button">
        {% include '@hdbt/misc/icon.twig' with {icon: 'angle-down', class: 'menu__toggle-button-icon'} %}
      </button>
    </span>
  </div>
  <div class="section-navigation__menu-wrapper" id="{{ section_menu_aria_controls }}">
    {% include '@hdbt/navigation/menu.html.twig' with { attributes: menu_attributes, allow_collabsible: true, auto_open: true } %}
  </div>
</nav>
