{#
  Values that should be passed:
    - options: list of Decision entities.
    - policymakers: Policymaker entities keyed by policymaker id.
    - selectedDecision: currently selected Decision entity.
#}

{% macro decision_label(decision, policymaker) %}
  {%- set org_label = (policymaker ? policymaker.getPolicymakerName()) ?: decision.getDecisionMakerOrgName() -%}
  {%- set meeting_date = decision.field_meeting_date.value ? decision.field_meeting_date.value|date('d.m.Y') -%}
  {%- set meeting_number = decision.field_meeting_sequence_number.value -%}
  {%- if meeting_number -%}
    {%- set meeting_date = meeting_number ~ '/' ~ meeting_date -%}
  {%- endif -%}
  {{- [org_label ?: decision.label, meeting_date]|filter(v => v)|join(' ') -}}
{% endmacro %}

{% import _self as dropdown %}

{% if options %}
<div class="issue__meetings-container">
  <div class="issue__meetings-labels">
    <label>{{ 'Process history'|trans }}</label>
    <div class="new-handlings-warning__wrapper">
      {%
        set warning_classes = [
          'warning-label',
          'issue__new-handlings-warning',
          show_warning ? 'visible'
        ]
      %}
      <div{{ attributes.addClass(warning_classes) }}>
        <div class="hds-tag hds-tag--alert">
          <span>{{ warning_label }}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="issue__meetings-dropdown">
    {% if options|length == 1 and selectedDecision.id == options[0].id %}
      {% set disabled = true %}
    {% else %}
      {% set disabled = false %}
    {% endif %}
    {% if selectedDecision %}
      {% set selected_label = dropdown.decision_label(selectedDecision, policymakers[selectedDecision.getPolicymakerId()] ?? null) %}
      {% include '@hdbt_subtheme/components/button.html.twig' with {type: 'secondary', disabled: disabled, label: selected_label, icon_last: true, icon_last_type: 'angle-down' } %}
    {% else %}
      {% include '@hdbt_subtheme/components/button.html.twig' with {type: 'secondary', disabled: false, label: 'Choose a handling'|t, icon_last: true, icon_last_type: 'angle-down' } %}
    {% endif %}
    <nav>
      <ul class="issue__meetings-select" aria-expanded='false' tabindex="-1" id='issue__meetings-select'>
        {% for option in options %}
          {% set policymaker = policymakers[option.getPolicymakerId()] ?? null %}
          {% set option_class = (policymaker ? policymaker.getPolicymakerClass() : 'color-board')|clean_class %}
          {% set option_label = dropdown.decision_label(option, policymaker) %}
          {% set option_url = path('entity.node.canonical', {node: option.id}) %}
          {% set is_selected = selectedDecision.id == option.id %}
          <li
            data-styleclass="border-left--{{ option_class }}"
            data-link="{{ option.getNormalizedNativeId() }}"
            data-url="{{ option_url }}"
            aria-selected="{{ is_selected ? 'true' : 'false' }}"
            tabindex="0"
            class="option{{ is_selected ? ' selected' }} border-left--{{ option_class }}"
            title="{{ option_label }}"
          >
            <a class="paatokset__link-plain" href="{{ option_url }}">{{ option_label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
  <noscript>
    <style>
      .issue__meetings-select {
        display: block;
      }

      .issue__meetings-dropdown button.hds-button {
        display: none;
      }

      .issue__meetings-container .option.selected {
        display: none;
      }
    </style>
  </noscript>
</div>
{% endif %}
