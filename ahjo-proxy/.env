# Default configuration. Do not commit secrets here: real values are
# provided as environment variables (or in .env.local for local development).

APP_ENV=prod
APP_SECRET=
LOG_LEVEL=info
TRUSTED_PROXIES=private_ranges

# Ahjo API base URL.
AHJO_ENDPOINT=https://ahjo.hel.fi:9802/ahjorest/v1

# Clients must send this value in the `api-key` header.
AHJO_PROXY_API_KEY=

# Optional upstream Ahjo proxy. When set, requests are forwarded to this
# proxy instead of AHJO_ENDPOINT, and the Ahjo auth token is not used.
# Useful for local development, since Ahjo is behind a firewall.
AHJO_UPSTREAM_PROXY_URL=
# Sent in the `api-key` header to the upstream proxy.
AHJO_UPSTREAM_PROXY_API_KEY=

# Ahjo OpenID connect.
AHJO_OPENID_AUTH_URL=https://johdontyopoyta.hel.fi/ids4/connect/authorize
AHJO_OPENID_TOKEN_URL=https://johdontyopoyta.hel.fi/ids4/connect/token
AHJO_OPENID_CLIENT_ID=paatoksetpalvelu
AHJO_OPENID_SCOPE="openid offline_access"
AHJO_OPENID_SECRET=
# Ahjo redirects here after login. Must be the public URL of
# the proxy /openid/callback, registered as a redirect URI in Ahjo.
AHJO_OPENID_REDIRECT_URI=https://ahjo-proxy-helsinki-paatokset.docker.so/openid/callback

# Admin authentication for the OpenID endpoints. Drupal sends the
# Keycloak access token of the logged-in admin, which is verified
# against the issuer. Everything is denied if these are not set.
#
# Keycloak realm URL, e.g. https://tunnistus.hel.fi/auth/realms/helsinki-tunnistus.
OIDC_ISSUER=
# Comma separated client ids the token may be issued to (Drupal's client id).
OIDC_ALLOWED_CLIENTS=
# Comma separated AD groups that may manage the Ahjo auth token.
# Defaults to the group that grants super_administrator in Drupal.
OIDC_ALLOWED_AD_GROUPS=947058f4-697e-41bb-baf5-f69b49e5579a

# Persistent storage for the Ahjo auth token. This should be a
# persistent volume in OpenShift.
TOKEN_STORAGE_DIR=%kernel.project_dir%/var/storage
