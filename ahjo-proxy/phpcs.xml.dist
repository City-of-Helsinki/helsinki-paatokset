<?xml version="1.0"?>
<ruleset name="ahjo-proxy">
  <description>Same rules as the Drupal project.</description>
  <arg name="extensions" value="php"/>
  <file>bin/console</file>
  <file>config</file>
  <file>public</file>
  <file>src</file>
  <file>tests</file>
  <!-- Generated by Symfony. -->
  <exclude-pattern>config/reference.php</exclude-pattern>
  <rule ref="Drupal" />
  <rule ref="DrupalPractice" />
  <rule ref="Generic.PHP.RequireStrictTypes" />
</ruleset>
